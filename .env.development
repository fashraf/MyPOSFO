# Committed on purpose: `npm run dev` works straight after `git clone`.
# Local overrides go in .env.development.local (git-ignored).

# mock = fully offline, seeded tenant databases in localStorage (default)
# api  = talk to POSAPI through the dev proxy below
VITE_DATA_SOURCE=mock

# Persona drawer on the login screen and the demo bar in the shell.
VITE_DEMO_TOOLS=true

# api mode only. Empty = same origin (/api, proxied by Vite).
VITE_API_BASE_URL=
API_PROXY_TARGET=http://localhost:5001

PORT=5173
