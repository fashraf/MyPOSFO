# Copy to .env.local (git-ignored) and edit. Every value has a safe default.

# ---- Data source -----------------------------------------------------------
# mock : offline demo, tenant databases in the browser (default)
# api  : POSAPI (.NET) — see "Connecting the backend" in the root README
VITE_DATA_SOURCE=mock

# Show the persona drawer + demo bar (mock mode only).
VITE_DEMO_TOOLS=true

# ---- API mode --------------------------------------------------------------
# Empty = same origin; the Vite dev server proxies /api to API_PROXY_TARGET.
# Set a full URL only when the API lives on another host (CORS must allow it).
VITE_API_BASE_URL=
API_PROXY_TARGET=http://localhost:5001

# ---- Hosting ---------------------------------------------------------------
# Sub-path for GitHub Pages project sites, e.g. /poscomplete/
VITE_BASE_PATH=/

# ---- Dev server -------------------------------------------------------------
PORT=5173
